+/**
+ * Obtiene el historial de mensajes de un donante.
+ */
+async function obtenerHistorialDonante(
+  telefono: string,
+  limite: number = 15,
+): Promise<string[]> {
+  try {
+    const mensajes = await db
+      .select({
+        contenido: mensajesLog.contenido,
+        direccion: mensajesLog.direccion,
+      })
+      .from(mensajesLog)
+      .where(eq(mensajesLog.telefono, telefono))
+      .orderBy(desc(mensajesLog.createdAt))
+      .limit(limite);
+
+    return mensajes
+      .reverse()
+      .map((m) => `${m.direccion === "saliente" ? "🤖" : "👤"}: ${m.contenido ?? ""}`);
+  } catch (err) {
+    logger.error({ err, telefono }, "Error obteniendo historial del donante");
+    return [];
+  }
+}
