+/**
+ * Genera un resumen de temas previos (reclamos, avisos, consultas recientes).
+ */
+async function resumenTemasPrevios(telefono: string): Promise<string> {
+  try {
+    const donante = await db
+      .select({ id: donantes.id })
+      .from(donantes)
+      .where(eq(donantes.telefono, telefono))
+      .limit(1);
+
+    if (donante.length === 0) return "Donante no encontrado.";
+
+    const donanteId = donante[0].id;
+    const treintaDiasAtras = new Date();
+    treintaDiasAtras.setDate(treintaDiasAtras.getDate() - 30);
+
+    const [reclamosRecientes, avisosRecientes, consultasRecientes] =
+      await Promise.all([
+        db
+          .select({
+            tipo: reclamos.tipo,
+            descripcion: reclamos.descripcion,
+            fecha: reclamos.fechaCreacion,
+          })
+          .from(reclamos)
+          .where(
+            and(
+              eq(reclamos.donanteId, donanteId),
+              gte(reclamos.fechaCreacion, treintaDiasAtras),
+            ),
+          )
+          .orderBy(desc(reclamos.fechaCreacion))
+          .limit(5),
+        db
+          .select({
+            tipo: avisos.tipo,
+            notas: avisos.notas,
+            fecha: avisos.createdAt,
+          })
+          .from(avisos)
+          .where(
+            and(
+              eq(avisos.donanteId, donanteId),
+              gte(avisos.createdAt, treintaDiasAtras),
+            ),
+          )
+          .orderBy(desc(avisos.createdAt))
+          .limit(5),
+        db
+          .select({
+            mensaje: consultas.mensaje,
+            fecha: consultas.createdAt,
+          })
+          .from(consultas)
+          .where(
+            and(
+              eq(consultas.telefono, telefono),
+              gte(consultas.createdAt, treintaDiasAtras),
+            ),
+          )
+          .orderBy(desc(consultas.createdAt))
+          .limit(5),
+      ]);
+
+    const partes: string[] = [];
+    if (reclamosRecientes.length > 0) {
+      partes.push(
+        `Reclamos: ${reclamosRecientes.map((r) => `${r.tipo}: ${r.descripcion?.slice(0, 80)}`).join(" | ")}`,
+      );
+    }
+    if (avisosRecientes.length > 0) {
+      partes.push(
+        `Avisos: ${avisosRecientes.map((a) => `${a.tipo}: ${a.notas?.slice(0, 80)}`).join(" | ")}`,
+      );
+    }
+    if (consultasRecientes.length > 0) {
+      partes.push(
+        `Consultas: ${consultasRecientes.map((c) => c.mensaje?.slice(0, 80)).join(" | ")}`,
+      );
+    }
+
+    return partes.length > 0 ? partes.join("; ") : "Sin actividad reciente.";
+  } catch (err) {
+    logger.error({ err, telefono }, "Error generando resumen de temas previos");
+    return "Error al generar resumen.";
+  }
+}
